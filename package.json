{
  "name": "career-market",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter @cm/worker run migrate",
    "builder": "pnpm --filter @cm/worker run build-once",
    "builder:watch": "pnpm --filter @cm/worker run watch",
    "api": "pnpm --filter @cm/api run start",
    "web:dev": "pnpm --filter @cm/web run dev",
    "web:build": "pnpm --filter @cm/web run build",
    "web:preview": "pnpm --filter @cm/web run preview",
    "web:check-ui": "pnpm --filter @cm/web run check:ui",
    "web-next:dev": "pnpm --filter @cm/web-next run dev",
    "web-next:build": "pnpm --filter @cm/web-next run build",
    "web-next:start": "pnpm --filter @cm/web-next run start",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "pnpm -r run lint",
    "worker": "pnpm --filter @cm/worker run build-once",
    "worker:watch": "pnpm --filter @cm/worker run watch",
    "worker:sweep": "pnpm --filter @cm/worker run sweep"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
