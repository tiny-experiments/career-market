# Copy to .env at the repository root. Every service reads it through packages/core/src/config.ts.

# Read model (Postgres 16). docker compose maps it to CM_PG_PORT (default 55432).
DATABASE_URL=postgres://cm:cm@127.0.0.1:55432/career_market

# krill public API. Without a key, calls share a low per-address rate limit.
KRILL_API_URL=https://krill.kurso.sh
# KRILL_API_KEY=krk_...
# KRILL_RATE_PER_MIN=50
# KRILL_CACHE_DIR=.cache/krill

# Worker: completed-snapshot build plus intraday change sweep
# BUILDER_POLL_MINUTES=5
# WORKER_SWEEP_MINUTES=15
# WORKER_CONCURRENCY=12
# GROWTH_MODE=like-for-like
# BUILDER_CLOSING_SAMPLE_PER_DAY=60
# BUILDER_GROUPED_REFRESH_DAYS=7
# BUILDER_SKILL_PAGES=60
# BUILDER_COMPANY_PROFILES=100

# Public read-only HTTP API in front of the read model (apps/api); no token. In production it
# runs on the VPS behind https://api.careers.market. For local development use http://127.0.0.1:4100.
READ_API_HOST=127.0.0.1
READ_API_PORT=4100
READ_API_URL=http://127.0.0.1:4100
# Set to 1 only when exactly one trusted reverse proxy is the sole ingress.
# API_TRUST_PROXY=0

# Company logos through Context.dev Logo Link (public client id). The Vite app reads the
# same id as VITE_LOGO_LINK_ID (only VITE_* variables reach the browser).
# CONTEXT_DEV_PUBLIC_CLIENT_ID=
# VITE_LOGO_LINK_ID=

LOG_LEVEL=info

# Low-priority description backfill; 0 disables it.
WORKER_BACKFILL_PER_MIN=120
