# Environment for deploy/docker-compose.yml (read API + builder on the VPS).
DATABASE_URL=postgres://career_market:CHANGE_ME@postgres:5432/career_market
KRILL_API_URL=https://krill.kurso.sh
# KRILL_API_KEY=krk_...
READ_API_TOKEN=CHANGE_ME_long_random_string
# The builder asks the web app (Vercel) to refresh right after each build.
WEB_REVALIDATE_URL=https://careers.market/api/revalidate
REVALIDATE_TOKEN=CHANGE_ME_long_random_string
LOG_LEVEL=info
