# Copy to deploy/.env on the VPS with mode 600; never commit it. docker compose reads it for
# ${...} values, and the api and worker containers receive it as their environment.

# Required. Use hex (openssl rand -hex 24) so it needs no URL escaping.
POSTGRES_PASSWORD=
# Required: the job data key for the worker and the API.
KRILL_API_KEY=
# Required for real logos. The public id is also set in Vercel as VITE_CONTEXT_DEV_PUBLIC_CLIENT_ID;
# the API key is server-side only and pays for brand lookups by company name.
CONTEXT_DEV_PUBLIC_CLIENT_ID=
CONTEXT_DEV_API_KEY=

# Caddy is the sole ingress and replaces X-Forwarded-For, so trust exactly one hop.
API_TRUST_PROXY=1
LOG_LEVEL=info

# Job data source. Leave these out to use the defaults.
# KRILL_API_URL=https://krill.kurso.sh
# KRILL_RATE_PER_MIN=500
# KRILL_TIMEOUT_MS=60000

# Worker: snapshot polling, intraday sweeps, growth basis ('like-for-like' or 'raw').
BUILDER_POLL_MINUTES=5
WORKER_SWEEP_MINUTES=15
WORKER_CONCURRENCY=12
GROWTH_MODE=like-for-like
# Low-priority description backfill; 0 disables it.
WORKER_BACKFILL_PER_MIN=120
# BUILDER_CLOSING_SAMPLE_PER_DAY=60
# BUILDER_GROUPED_REFRESH_DAYS=7
# BUILDER_SKILL_PAGES=60
# BUILDER_COMPANY_PROFILES=100

# Logo resolver budgets. Leave these out to use the defaults.
# LOGO_DAILY_CREDITS=1000
# LOGO_DAILY_CHECKS=3000
# LOGO_LOOKUPS_PER_RUN=100
# LOGO_CHECKS_PER_RUN=300
# LOGO_RECHECK_DAYS=90
# LOGO_MONOGRAM_RECHECK_DAYS=7
# LOGO_RUN_MINUTES=30
# LOGO_LOOKUP_INTERVAL_MS=500
# LOGO_CHECK_REFERER=https://careermarket.app/

# Set by deploy/docker-compose.yml or the image; do not put them here:
#   DATABASE_URL, READ_API_HOST, READ_API_PORT, NODE_ENV, KRILL_CACHE_DIR, NODE_OPTIONS (worker)
# Only for the retired Next.js app; leave them unset:
#   READ_API_URL, READ_API_TOKEN, REVALIDATE_TOKEN, WEB_REVALIDATE_URL
