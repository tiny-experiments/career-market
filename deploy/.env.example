# Environment for deploy/docker-compose.yml (read API + worker on the VPS).
DATABASE_URL=postgres://career_market:CHANGE_ME@postgres:5432/career_market
KRILL_API_URL=https://krill.kurso.sh
# KRILL_API_KEY=krk_...
# The reverse proxy is the sole ingress: trust one hop so rate limits are per client.
API_TRUST_PROXY=1
LOG_LEVEL=info

# Keyed worker: metadata checks and intraday sweeps
# Key is set above.
BUILDER_POLL_MINUTES=5
WORKER_SWEEP_MINUTES=15
WORKER_CONCURRENCY=12
GROWTH_MODE=like-for-like

# Low-priority description backfill; 0 disables it.
WORKER_BACKFILL_PER_MIN=120
