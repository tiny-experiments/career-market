{
  "name": "@cm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src test --deny-warnings",
    "test": "vitest run --root ../.. apps/api/test",
    "db:types": "kysely-codegen --out-file src/database/generated.ts --date-parser string --numeric-parser number",
    "db:types:check": "pnpm db:types --verify"
  },
  "dependencies": {
    "@cm/core": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.92.0",
    "supertest": "^7.3.2"
  }
}
