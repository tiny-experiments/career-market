{
  "name": "@cm/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/cli.ts migrate",
    "build-once": "node --env-file-if-exists=../../.env --import tsx src/cli.ts build",
    "watch": "node --env-file-if-exists=../../.env --import tsx src/cli.ts watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "sweep": "node --env-file-if-exists=../../.env --import tsx src/cli.ts sweep"
  },
  "dependencies": {
    "@cm/core": "workspace:*",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "pino": "^10.4.0"
  },
  "exports": {
    "./descriptions": "./src/descriptions.ts",
    "./krill": "./src/krill/api.ts",
    "./client": "./src/krill/client.ts"
  }
}
